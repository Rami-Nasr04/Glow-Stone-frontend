{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "rewrites": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "studio.glowstonelb.com" }], "destination": "/__spa-fallback.html" },
    { "source": "/(sign-in|sign-up|verify|forgot-password)", "destination": "/__spa-fallback.html" },
    { "source": "/collection/([0-9]+)", "destination": "/__spa-fallback.html" },
    { "source": "/collection/([0-9]+)/([^/]+)", "destination": "/__spa-fallback.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "studio.glowstonelb.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ]
}
